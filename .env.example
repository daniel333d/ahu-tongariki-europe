CONTACT_FROM_EMAIL=
RESEND_API_KEY=

# Site-wide password gate (middleware + /dostep). Must be exactly "true" to enforce it.
SITE_PROTECTION_ENABLED=false
# Single current access password. Rotating it invalidates all existing sessions.
SITE_PASSWORD=
# Secret used to sign/verify the session cookie. Generate with: openssl rand -hex 32
SITE_AUTH_SECRET=
