CONTACT_FROM_EMAIL=
# Recipient inbox for the investor-inquiry form (app/api/investor-inquiry/route.ts). Required in production.
CONTACT_TO_EMAIL=
RESEND_API_KEY=

# Site-wide password gate (middleware + /dostep). Must be exactly "true" to enforce it.
SITE_PROTECTION_ENABLED=false
# Single current access password. Rotating it invalidates all existing sessions.
SITE_PASSWORD=
# Optional extra access passwords, separated by commas, semicolons, or new lines.
SITE_PASSWORDS=
# Optional named extra access password.
SITE_PASSWORD_ROBERT=
SITE_PASSWORD_DAREK=
SITE_PASSWORD_JORANA=
# Secret used to sign/verify the session cookie. Generate with: openssl rand -hex 32
SITE_AUTH_SECRET=
